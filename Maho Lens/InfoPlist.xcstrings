    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Maho Lens needs the camera to cast its transformation spells on your live preview."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Maho Lens はライブプレビューに変身魔法をかけるためにカメラを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Maho Lens 需要使用相机，为实时预览施放变身魔法。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Maho Lens saves the photos you take to your library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Maho Lens は撮影した写真をライブラリに保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Maho Lens 会将拍摄的照片保存到您的图库。"
          }
        }
      }
    }
  },
