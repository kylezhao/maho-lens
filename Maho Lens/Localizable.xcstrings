{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Accurate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高精度"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精确"
          }
        }
      }
    },
    "Add Item": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加项目"
          }
        }
      }
    },
    "Also save to Photos library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリにも保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时保存到照片图库"
          }
        }
      }
    },
    "At 30 fps the preview must stay above 25 fps; at 60 fps above 50 fps. The dial on the camera screen turns green when it does.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30 fps 設定ではプレビューが 25 fps 以上、60 fps 設定では 50 fps 以上を維持する必要があります。達成するとカメラ画面のダイヤルが緑色になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 fps 设置下预览需保持在 25 fps 以上；60 fps 设置下需保持在 50 fps 以上。达标时相机界面的表盘会变为绿色。"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背面"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后置"
          }
        }
      }
    },
    "Background blur": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景ぼかし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景虚化"
          }
        }
      }
    },
    "Balanced": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バランス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "均衡"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机"
          }
        }
      }
    },
    "Camera access is off. Allow it in Settings to cast spells.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフです。魔法を使うには「設定」で許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机访问已关闭。请在“设置”中允许后再施放魔法。"
          }
        }
      }
    },
    "Capture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Cool tones": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寒色トーン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冷色调"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制"
          }
        }
      }
    },
    "Copy report": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートをコピー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制报告"
          }
        }
      }
    },
    "Copyright © 2026 Kyle Zhao. All rights reserved.": {
      "localizations": {},
      "shouldTranslate": false
    },
    "Delete": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Demo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示"
          }
        }
      }
    },
    "Display and saving": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示と保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示与保存"
          }
        }
      }
